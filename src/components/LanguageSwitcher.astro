---
// src/components/LanguageSwitcher.astro
// Switches between /fr/... and /en/... preserving the current slug

interface Props {
  /** Current locale: 'fr' | 'en' */
  currentLocale: string;
}

const { currentLocale } = Astro.props;

const path = Astro.url.pathname;
let otherPath: string;

if (currentLocale === 'fr') {
  // FR is at /…  → EN is at /en/…
  // Also swap route segment: /tutoriels/ → /tutorials/
  const enPath = path === '/' ? '/en/' : `/en${path}`;
  otherPath = enPath.replace('/tutoriels/', '/tutorials/');
} else {
  // EN is at /en/… → FR is at /…
  // Also swap route segment: /tutorials/ → /tutoriels/
  const frPath = path.replace(/^\/en/, '') || '/';
  otherPath = frPath.replace('/tutorials/', '/tutoriels/');
}

const labels: Record<string, { other: string; flag: string }> = {
  fr: { other: 'EN', flag: '🇬🇧' },
  en: { other: 'FR', flag: '🇫🇷' },
};

const { flag, other } = labels[currentLocale] ?? labels['fr'];
---

<a
  href={otherPath}
  aria-label={`Passer en ${other}`}
  class="
    flex items-center gap-1.5
    text-sm font-medium
    text-gray-600 dark:text-gray-300
    hover:text-gray-900 dark:hover:text-white
    transition-colors duration-200
    rounded-lg px-2 py-1
    hover:bg-gray-100 dark:hover:bg-gray-800
  "
>
  <span aria-hidden="true">{flag}</span>
  <span>{other}</span>
</a>
