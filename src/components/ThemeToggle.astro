---
// src/components/ThemeToggle.astro
// Dark / Light mode toggle – logique complète, auto-suffisant
---

<button
  id="theme-toggle"
  aria-label="Basculer le thème / Toggle theme"
  title="Basculer le thème"
  class="
    relative flex items-center justify-center
    w-9 h-9 rounded-lg
    text-gray-600 dark:text-gray-300
    hover:bg-gray-100 dark:hover:bg-gray-800
    transition-colors duration-200
  "
>
  <!-- Soleil — affiché en mode sombre -->
  <svg
    class="w-5 h-5 hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round"
      d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364-1.414 1.414M7.05 16.95l-1.414 1.414M18.364 18.364l-1.414-1.414M7.05 7.05 5.636 5.636M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"
    />
  </svg>

  <!-- Lune — affichée en mode clair -->
  <svg
    class="w-5 h-5 block dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round"
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
    />
  </svg>
</button>

<script is:inline>
  // Logique complète du thème — réinjectée à chaque navigation (is:inline)
  (function () {
    var html = document.documentElement;

    function getTheme() {
      var stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(t) {
      html.classList.toggle('dark', t === 'dark');
      localStorage.setItem('theme', t);
    }

    // Applique le thème sauvegardé au chargement / après navigation
    applyTheme(getTheme());

    // Branchement du bouton — on retire l'ancien listener avant d'en ajouter un nouveau
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      var newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', function () {
        var next = html.classList.contains('dark') ? 'light' : 'dark';
        applyTheme(next);
      });
    }
  })();
</script>
