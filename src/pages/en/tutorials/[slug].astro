---
// src/pages/en/tutorials/[slug].astro
// Dynamic routes for individual English tutorial articles

import { getCollection } from 'astro:content';
import TutorialLayout    from '../../../layouts/TutorialLayout.astro';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutoriels', ({ data }) =>
    data.lang === 'en' && !data.draft
  );

  return tutorials.map((entry) => ({
    params: { slug: entry.slug.replace('en/', '') },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, description, date, tags, cover } = entry.data;
---

<TutorialLayout
  {title}
  {description}
  {date}
  locale="en"
  {tags}
  cover={cover}
>
  <Content />
</TutorialLayout>
