---
// src/pages/index.astro
// Page racine : redirige vers /fr/ sans noindex
// Google indexera cette page normalement grâce au canonical
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alex6 — Portfolio</title>
    <meta name="description" content="Portfolio personnel d'Alex6 — tutoriels Big Data, systèmes, homelab et plus." />
    <!-- Indique à Google la page canonique -->
    <link rel="canonical" href="https://alex6.github.io/fr/" />
    <!-- Redirection immédiate vers /fr/ -->
    <meta http-equiv="refresh" content="0;url=/fr/" />
  </head>
  <body>
    <a href="/fr/">Redirection vers la version française…</a>
  </body>
</html>

