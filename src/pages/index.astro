---
// src/pages/index.astro
// Splash redirect page: / → /fr/ ou /en/ selon la langue du navigateur

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Alex6"
  description="Portfolio d'Alex6 — redirection en cours."
  locale="fr"
>
  <div class="flex flex-col items-center justify-center min-h-[60vh] gap-8 text-center">

    <!-- Logo / nom -->
    <div class="fade-in">
      <p class="text-5xl font-bold tracking-tight text-gray-900 dark:text-white">
        Alex6
      </p>
      <p class="mt-2 text-[var(--color-muted)] text-sm">Portfolio</p>
    </div>

    <!-- Spinner animé -->
    <div
      class="w-10 h-10 rounded-full border-4 border-[var(--color-border)] border-t-brand-500 animate-spin"
      role="status"
      aria-label="Chargement…"
    ></div>

    <!-- Liens de secours si JS est désactivé -->
    <noscript>
      <div class="flex gap-4 mt-4">
        <a href="/fr/" class="text-brand-600 dark:text-brand-400 hover:underline font-medium">
          🇫🇷 Français
        </a>
        <a href="/en/" class="text-brand-600 dark:text-brand-400 hover:underline font-medium">
          🇬🇧 English
        </a>
      </div>
    </noscript>

  </div>
</BaseLayout>

<script is:inline>
  // Redirige immédiatement vers la bonne locale selon la langue du navigateur
  (function () {
    const lang = (navigator.language || 'fr').toLowerCase();
    const dest = lang.startsWith('en') ? '/en/' : '/fr/';
    window.location.replace(dest);
  })();
</script>
