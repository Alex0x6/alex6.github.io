---
// src/pages/fr/tutoriels/[slug].astro
// Redirige /fr/tutoriels/[slug]/ → /tutoriels/[slug]/

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const tutoriels = await getCollection('tutoriels', ({ data }: { data: any }) =>
    data.lang === 'fr' && !data.draft
  );
  return tutoriels.map((entry: any) => ({
    params: { slug: entry.slug.replace('fr/', '') },
    props:  { slug: entry.slug.replace('fr/', '') },
  }));
}

const { slug } = Astro.props;
const targetUrl = `/tutoriels/${slug}/`;
---
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Redirection…</title>
    <link rel="canonical" href={`https://alex6.github.io/tutoriels/${slug}/`} />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
  </head>
  <body>
    <a href={targetUrl}>Redirection vers le tutoriel…</a>
  </body>
</html>
