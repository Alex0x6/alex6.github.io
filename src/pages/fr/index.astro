---
// src/pages/fr/index.astro
// Page d'accueil en français

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Alex6 — Portfolio"
  description="Portfolio personnel d'Alex6 — tutoriels Big Data, systèmes, homelab et plus."
  locale="fr"
>

  <!-- Hero -->
  <section class="text-center py-16 sm:py-24 fade-in">
    <p class="text-brand-600 dark:text-brand-400 text-sm font-semibold tracking-widest uppercase mb-4">
      Bienvenue
    </p>
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6">
      Salut, je suis <span class="text-brand-600 dark:text-brand-400">Alex6</span>
    </h1>
    <p class="text-lg sm:text-xl text-[var(--color-muted)] max-w-2xl mx-auto mb-10 leading-relaxed">
      Passionné de systèmes, de Big Data et de virtualisation. Ici, je partage mes tutoriels,
      expériences et projets en homelab.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/fr/tutoriels/"
        class="
          inline-flex items-center justify-center gap-2
          bg-brand-600 hover:bg-brand-700
          text-white font-medium
          px-6 py-3 rounded-xl
          transition-colors duration-200
          shadow-lg shadow-brand-500/20
        "
      >
        Voir les tutoriels →
      </a>
      <a
        href="https://github.com/Alex0x6"
        target="_blank"
        rel="noopener noreferrer"
        class="
          inline-flex items-center justify-center gap-2
          border border-[var(--color-border)]
          text-[var(--color-text)] font-medium
          px-6 py-3 rounded-xl
          hover:bg-[var(--color-surface)]
          transition-colors duration-200
        "
      >
        GitHub ↗
      </a>
    </div>
  </section>

  <!-- Divider -->
  <hr class="border-[var(--color-border)] my-4" />

  <!-- Highlights -->
  <section class="py-12">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">
      Ce que vous trouverez ici
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        {
          icon: '📖',
          title: 'Tutoriels techniques',
          desc: 'Guides pas à pas sur Proxmox, Linux, Big Data, Kubernetes et plus.',
        },
        {
          icon: '🏠',
          title: 'Projets Homelab',
          desc: 'Architecture, configs et retours d\'expérience sur mon homelab.',
        },
        {
          icon: '🛠️',
          title: 'Outils & Scripts',
          desc: 'Scripts utiles, automatisations et configurations prêtes à l\'emploi.',
        },
      ].map(({ icon, title, desc }) => (
        <div class="
          p-6 rounded-2xl
          border border-[var(--color-border)]
          bg-[var(--color-surface)]
          hover:border-brand-500/40
          hover:shadow-md hover:shadow-brand-500/5
          transition-all duration-300
        ">
          <div class="text-3xl mb-3">{icon}</div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{title}</h3>
          <p class="text-sm text-[var(--color-muted)]">{desc}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
